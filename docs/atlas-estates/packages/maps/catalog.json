[{"id":"cn","name":"中国城市之旅","description":"从水巷和茶园出发，沿江而行，最后抵达繁忙的海港。","color":"#245d63","landmarks":["扬州","重庆","北京"],"difficulty":"入门","art":"./packages/maps/art/cn-board.webp","icon":"./packages/maps/art/cn-icon.svg","duration":"约 25–60 分钟","players":"2–4 人","theme":"山水长卷"},{"id":"world","name":"世界环游","description":"带着一册空白护照，串起六大洲的市集、山脊与海湾。","color":"#254d76","landmarks":["基多","温哥华","纽约"],"difficulty":"进阶","art":"./packages/maps/art/world-board.webp","icon":"./packages/maps/art/world-icon.svg","duration":"约 25–60 分钟","players":"2–4 人","theme":"经纬航线"},{"id":"us","name":"美国城市之旅","description":"穿越红岩峡谷与开阔平原，把西岸码头和东岸街区连成一线。","color":"#894638","landmarks":["图森","奥斯汀","纽约"],"difficulty":"进阶","art":"./packages/maps/art/us-board.webp","icon":"./packages/maps/art/us-icon.svg","duration":"约 25–60 分钟","players":"2–4 人","theme":"峡谷铁路线"},{"id":"uk","name":"英国城市之旅","description":"乘雾港轮渡，沿石墙步道探访大学城、湖区和古老的钟楼。","color":"#405970","landmarks":["巴斯","诺丁汉","伦敦"],"difficulty":"入门","art":"./packages/maps/art/uk-board.webp","icon":"./packages/maps/art/uk-icon.svg","duration":"约 25–60 分钟","players":"2–4 人","theme":"雾港钟声"},{"id":"fr","name":"法国城市之旅","description":"从葡萄园与旧城屋顶启程，沿河谷前往蔚蓝的地中海岸。","color":"#745279","landmarks":["科尔马","格勒诺布尔","巴黎"],"difficulty":"普通","art":"./packages/maps/art/fr-board.webp","icon":"./packages/maps/art/fr-icon.svg","duration":"约 25–60 分钟","players":"2–4 人","theme":"河谷与花园"},{"id":"de","name":"德国城市之旅","description":"随森林小径走进山谷集镇，穿过连绵的城墙与莱茵河畔。","color":"#395d4b","landmarks":["班贝格","汉诺威","柏林"],"difficulty":"进阶","art":"./packages/maps/art/de-board.webp","icon":"./packages/maps/art/de-icon.svg","duration":"约 25–60 分钟","players":"2–4 人","theme":"林谷河港"},{"id":"jp","name":"日本城市之旅","description":"沿海岸与山麓换乘地方线，在温泉街、庭园和灯火港口之间经营。","color":"#845563","landmarks":["仓敷","新潟","东京"],"difficulty":"普通","art":"./packages/maps/art/jp-board.webp","icon":"./packages/maps/art/jp-icon.svg","duration":"约 25–60 分钟","players":"2–4 人","theme":"海峡与山影"},{"id":"it","name":"意大利城市之旅","description":"跟随丘陵间的石